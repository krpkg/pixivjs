{
  "name": "@krpkg/pixivjs",
  "version": "1.0.1",
  "description": "Lightweight, universal TypeScript client and SDK for Pixiv artwork metadata and downloads",
  "license": "Apache-2.0",
  "author": "krpkg",
  "keywords": [
    "pixiv",
    "pixiv-api",
    "pixiv-downloader",
    "artwork",
    "ugoira",
    "pximg",
    "typescript",
    "sdk"
  ],
  "homepage": "https://github.com/krpkg/pixivjs#readme",
  "bugs": {
    "url": "https://github.com/krpkg/pixivjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/krpkg/pixivjs.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.mjs",
      "require": "./dist/errors.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
